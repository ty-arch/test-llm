{
  "name": "llm",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "clients/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:chat-web": "turbo run dev --filter=@autix/chat-web",
    "dev:chat": "turbo run dev --filter=@autix/chat",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
