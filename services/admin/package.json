{
  "name": "@autix/admin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "tsc",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}
